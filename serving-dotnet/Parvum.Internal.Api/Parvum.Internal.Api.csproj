<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <!-- One dependency, on purpose: the Postgres driver. Queries are written as
       SQL and rows are read by hand (see PostgresStores.cs), which is the same
       stance the Java service takes with jOOQ: the SQL is the thing to review. -->
  <ItemGroup>
    <PackageReference Include="Npgsql" Version="9.*" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Parvum.Internal.Api.Tests" />
  </ItemGroup>

</Project>
